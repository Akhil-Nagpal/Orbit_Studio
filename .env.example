# Environment
NODE_ENV=development
PORT=5000

# Redis Secrets
# For Local
REDIS_URL=redis://127.0.0.1:6379/0
# For production 
REDIS_URL=rediss://default:<password>@<host>:<port>/0 # Production url starts with "rediss" instead of "redis" extra s (Secure) is for SSL/TLS encryption 

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
DB_NAME=your_db_name

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=short_lived_token_in_seconds
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=long_lived_token_in_seconds

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=your_folder_name

# Cookies
ACCESS_TOKEN_MAX_AGE=short_lived_token_age_in_milliseconds
REFRESH_TOKEN_MAX_AGE=long_lived_token_age_in_milliseconds

# Logging
LOG_LEVEL=debug
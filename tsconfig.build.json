{
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",

    "rootDir": "./src",
    "outDir": "./dist",

    "noEmit": false,
    "rewriteRelativeImportExtensions": true,

    "declaration": false,
    "sourceMap": false
  },

  "include": ["src"]
}
